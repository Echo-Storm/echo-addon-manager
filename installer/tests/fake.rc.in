#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @FAKE_VERSION_CSV@
 PRODUCTVERSION @FAKE_VERSION_CSV@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@FAKE_COMPANY@"
            VALUE "FileDescription", "@FAKE_PRODUCT@ (a stand-in for the installer's tests)"
            VALUE "FileVersion", "@FAKE_VERSION@"
            VALUE "ProductName", "@FAKE_PRODUCT@"
            VALUE "ProductVersion", "@FAKE_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
