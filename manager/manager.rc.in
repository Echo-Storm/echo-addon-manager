// Generated into the build folder by CMake from the project version. The version resource is how the installer (and Windows Explorer) can tell this
// Lossless.dll from Lossless Scaling's own without loading it: ProductName "Addon Manager for Lossless Scaling" here (before 0.9.1 "Echo Addon Manager"), "Lossless Scaling" in the original.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @LSAddonManager_VERSION_MAJOR@,@LSAddonManager_VERSION_MINOR@,@LSAddonManager_VERSION_PATCH@,0
 PRODUCTVERSION @LSAddonManager_VERSION_MAJOR@,@LSAddonManager_VERSION_MINOR@,@LSAddonManager_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Echo-Storm"
            VALUE "FileDescription", "Addon Manager for Lossless Scaling: stands in for Lossless Scaling's Lossless.dll, forwards to Lossless_original.dll and loads addons"
            VALUE "FileVersion", "@LSAddonManager_VERSION@"
            VALUE "InternalName", "Lossless"
            VALUE "LegalCopyright", "MIT licence"
            VALUE "OriginalFilename", "Lossless.dll"
            VALUE "ProductName", "Addon Manager for Lossless Scaling"
            VALUE "ProductVersion", "@LSAddonManager_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
